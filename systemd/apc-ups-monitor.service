[Unit]
Description=UPS Monitor Service
Documentation=https://github.com/sayeed99/apc-ups-monitor
After=network.target network-online.target
Wants=network-online.target
Wants=apcupsd.service

[Service]
Type=simple
User=apc-ups-monitor
Group=apc-ups-monitor
WorkingDirectory=/var/lib/apc-ups-monitor
ExecStart=/usr/bin/apc-ups-monitor --host=0.0.0.0 --port=8555 --db-path=/var/lib/apc-ups-monitor/ups_monitoring.db --log-level=INFO
ExecReload=/bin/kill -HUP $MAINPID
KillMode=mixed
KillSignal=SIGINT
TimeoutStopSec=30
Restart=always
RestartSec=5

# sudo is limited to the exact commands in /etc/sudoers.d/apc-ups-monitor.
NoNewPrivileges=false
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/apc-ups-monitor /var/log/apc-ups-monitor /etc/apcupsd /etc/default
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
# RestrictRealtime=true  # Disabled for WebSocket performance
# RestrictNamespaces=true  # Disabled for WebSocket compatibility
# LockPersonality and RestrictAddressFamilies are intentionally omitted because
# systemd makes NoNewPrivileges effective when they are enabled, which prevents
# the service's tightly scoped sudo commands from updating/restarting apcupsd.
# MemoryDenyWriteExecute=true  # Disabled - may interfere with WebSocket libraries
# SystemCallFilter=@system-service  # Disabled for WebSocket compatibility
# SystemCallErrorNumber=EPERM  # Disabled for WebSocket compatibility

# Environment
Environment=PYTHONPATH=/usr/lib/python3/dist-packages
Environment=UPS_MONITOR_DB_PATH=/var/lib/apc-ups-monitor/ups_monitoring.db
Environment=UPS_MONITOR_LOG_PATH=/var/log/apc-ups-monitor

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=apc-ups-monitor

[Install]
WantedBy=multi-user.target
