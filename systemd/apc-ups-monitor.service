[Unit]
Description=UPS Monitor Service
Documentation=https://github.com/sayeed99/apc-ups-monitor
After=network.target network-online.target
Wants=network-online.target
Wants=apcupsd.service

[Service]
Type=simple
User=apc-ups-monitor
Group=apc-ups-monitor
WorkingDirectory=/var/lib/apc-ups-monitor
ExecStart=/usr/bin/apc-ups-monitor --host=0.0.0.0 --port=8555 --db-path=/var/lib/apc-ups-monitor/ups_monitoring.db --log-level=INFO
ExecReload=/bin/kill -HUP $MAINPID
KillMode=mixed
KillSignal=SIGINT
TimeoutStopSec=30
Restart=always
RestartSec=5

# The service stays unprivileged. Privileged apcupsd operations are limited to
# the exact commands listed in /etc/sudoers.d/apc-ups-monitor.
NoNewPrivileges=false
# Do not add systemd namespace/hardening directives here without checking
# systemd.exec(5): many implicitly force NoNewPrivileges for User= services and
# would disable these intentionally restricted sudo operations.

# Environment
Environment=PYTHONPATH=/usr/lib/python3/dist-packages
Environment=UPS_MONITOR_DB_PATH=/var/lib/apc-ups-monitor/ups_monitoring.db
Environment=UPS_MONITOR_LOG_PATH=/var/log/apc-ups-monitor

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=apc-ups-monitor

[Install]
WantedBy=multi-user.target
