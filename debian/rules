#!/usr/bin/make -f

export DH_VERBOSE=1
export PYBUILD_NAME=apc-ups-monitor

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_test:
	# Skip tests during package build

override_dh_auto_install:
	dh_auto_install
	# Install systemd service file
	install -D -m 644 systemd/apc-ups-monitor.service debian/apc-ups-monitor/lib/systemd/system/apc-ups-monitor.service
	# Install configuration directory
	install -d debian/apc-ups-monitor/etc/apc-ups-monitor
	# Install data directory
	install -d debian/apc-ups-monitor/var/lib/apc-ups-monitor
	# Install log directory
	install -d debian/apc-ups-monitor/var/log/apc-ups-monitor

override_dh_systemd_enable:
	dh_systemd_enable --name=apc-ups-monitor apc-ups-monitor.service

override_dh_systemd_start:
	dh_systemd_start --name=apc-ups-monitor apc-ups-monitor.service